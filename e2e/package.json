{
  "name": "armazenda-e2e",
  "version": "1.0.0",
  "description": "End-to-end tests for Armazenda using Playwright",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "codegen": "playwright codegen",
    "db:start": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:stop": "docker compose -f docker-compose.test.yml down -v",
    "db:seed": "PGPASSWORD=test psql -h localhost -p 5433 -U test -d armazenda_test -f fixtures/test-user.sql"
  },
  "keywords": [
    "e2e",
    "playwright",
    "armazenda",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
